# ─── Banco de Dados ──────────────────────────────────────────────────────────
DB_NAME=otimiz_db
DB_USER=otimiz_admin
DB_PASSWORD=your_secure_password_here

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=1d

# ─── Optimizer (Python) ──────────────────────────────────────────────────────
INTERNAL_OPTIMIZER_KEY=your_internal_key_here

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
