# ─── Banco de Dados ──────────────────────────────────────────────────────────
DB_NAME=otimiz_db
DB_USER=otimiz_admin
DB_PASSWORD=your_secure_password_here

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=your_redis_password_here

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=15m

# ─── Optimizer (Python) ──────────────────────────────────────────────────────
INTERNAL_OPTIMIZER_KEY=your_internal_key_here_min_32_chars

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
FRONTEND_URL=https://yourdomain.com

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ─── SMTP (e-mail) ───────────────────────────────────────────────────────────
# If SMTP_HOST is unset, e-mails are printed to stdout (dev mode)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=OTIMIZ <noreply@yourdomain.com>

# ─── Sentry (opcional — remove se não usar) ───────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Observabilidade ─────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_grafana_password_here
FLOWER_USER=admin
FLOWER_PASSWORD=your_flower_password_here

# ─── Alertas (Alertmanager) ──────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=alertmanager@yourdomain.com
SMTP_USER=alertmanager@yourdomain.com
SMTP_PASS=your_smtp_password
ALERT_EMAIL=ops@yourdomain.com
ALERT_EMAIL_CRITICAL=oncall@yourdomain.com
