{
  "title": "OTIMIZ — Operational Overview",
  "uid": "otimiz-ops",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["otimiz", "production"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Optimizer — Request Rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "rate(http_requests_total{job=\"optimizer\"}[1m])", "legendFormat": "req/s" }]
    },
    {
      "id": 2, "type": "stat", "title": "Optimizer — Error Rate",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "rate(http_requests_total{job=\"optimizer\",status=~\"5..\"}[5m]) / rate(http_requests_total{job=\"optimizer\"}[5m])", "legendFormat": "error rate" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [{"color":"green","value":null},{"color":"orange","value":0.01},{"color":"red","value":0.05}] } } }
    },
    {
      "id": 3, "type": "stat", "title": "Backend — Request Rate (req/s)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "rate(http_requests_total{job=\"backend\"}[1m])", "legendFormat": "req/s" }]
    },
    {
      "id": 4, "type": "stat", "title": "Backend — Error Rate",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "rate(http_requests_total{job=\"backend\",status=~\"5..\"}[5m]) / rate(http_requests_total{job=\"backend\"}[5m])", "legendFormat": "error rate" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [{"color":"green","value":null},{"color":"orange","value":0.01},{"color":"red","value":0.02}] } } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Optimizer — Latency P50 / P95 / P99",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"optimizer\"}[5m]))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"optimizer\"}[5m]))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"optimizer\"}[5m]))", "legendFormat": "P99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Backend — Latency P50 / P95",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m]))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m]))", "legendFormat": "P95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7, "type": "stat", "title": "PostgreSQL — Active Connections",
      "gridPos": { "x": 0, "y": 12, "w": 6, "h": 4 },
      "targets": [{ "expr": "pg_stat_activity_count", "legendFormat": "connections" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{"color":"green","value":null},{"color":"orange","value":50},{"color":"red","value":80}] } } }
    },
    {
      "id": 8, "type": "stat", "title": "Redis — Memory Used",
      "gridPos": { "x": 6, "y": 12, "w": 6, "h": 4 },
      "targets": [{ "expr": "redis_memory_used_bytes", "legendFormat": "bytes" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 9, "type": "stat", "title": "Services Up",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 4 },
      "targets": [{ "expr": "up", "legendFormat": "{{job}}" }],
      "fieldConfig": { "defaults": { "mappings": [{"options":{"0":{"color":"red","text":"DOWN"},"1":{"color":"green","text":"UP"}},"type":"value"}] } }
    }
  ]
}
